<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight：浅色/深色色值在 colors.xml 与 values-night/colors.xml 中分别定义 -->
    <style name="Theme.YunHuPad" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorForeground">@color/panel_focus</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="Theme.YunHuPad.Fullscreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
