<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight：浅色/深色色值在 colors.xml 与 values-night/colors.xml 中分别定义 -->
    <style name="Theme.YunHuPad" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorForeground">@color/panel_focus</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="Theme.YunHuPad.Fullscreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 社区页顶部四个入口的公共尺寸约束：高度、字号、最小宽度统一 -->
    <style name="CommunityEntryButtonBase">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:background">@drawable/bg_button_focus</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 默认（横屏）：沿用原有 160dp 定宽，三个版块入口不参与拉伸 -->
    <style name="CommunityEntryButton" parent="CommunityEntryButtonBase">
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_weight">0</item>
    </style>

    <!-- 搜索入口两种方向一致：吃满该行剩余宽度 -->
    <style name="CommunityEntrySearchButton" parent="CommunityEntryButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
